{
  "components": {
    "schemas": {
      "BalanceLimitResponse": {
        "properties": {
          "depositIds": {
            "items": {
              "type": "integer"
            },
            "title": "Depositids",
            "type": "array"
          },
          "detail": {
            "const": "balance limit exceeded",
            "title": "Detail",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "detail",
          "message",
          "depositIds"
        ],
        "title": "BalanceLimitResponse",
        "type": "object"
      },
      "DepositResponse": {
        "properties": {
          "balance": {
            "title": "Balance",
            "type": "number"
          },
          "days": {
            "title": "Days",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "planType": {
            "title": "Plantype",
            "type": "string"
          },
          "withdrawals": {
            "items": {
              "$ref": "#/components/schemas/WithdrawalResponse"
            },
            "title": "Withdrawals",
            "type": "array"
          }
        },
        "required": [
          "id",
          "planType",
          "balance",
          "days",
          "withdrawals"
        ],
        "title": "DepositResponse",
        "type": "object"
      },
      "WithdrawalResponse": {
        "properties": {
          "amount": {
            "title": "Amount",
            "type": "number"
          },
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "timeDepositId": {
            "title": "Timedepositid",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "timeDepositId",
          "amount",
          "date"
        ],
        "title": "WithdrawalResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Time Deposit API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/time-deposits": {
      "get": {
        "description": "Returns every stored time deposit with its plan type, current balance, days, and withdrawal history. Balances and withdrawal amounts are JSON numbers; dates are ISO `YYYY-MM-DD`. Deposit `days` stays as stored; withdrawals are historical records already reflected in the stored balance. An empty database returns an empty array.",
        "operationId": "listTimeDeposits",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DepositResponse"
                  },
                  "title": "Response Listtimedeposits",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List all time deposits"
      }
    },
    "/time-deposits/update-balances": {
      "post": {
        "description": "Applies exactly one monthly accrual to every stored deposit, in a single transaction that locks the deposit rows. Interest is monthly: basic 1%, student 3% while under 366 days, premium 5% after 45 days; no interest applies within the first 30 days, and an unknown plan type earns none. Deposit `days` never changes and withdrawal rows are not touched. The call is not idempotent: each success adds another accrual permanently. Balances are stored as NUMERIC(18,5) bounded to \u00b11000000000000; if the accrual would move any deposit outside that range the whole batch is rejected with 409 and nothing is written. Responds with an empty body.",
        "operationId": "updateTimeDepositBalances",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BalanceLimitResponse"
                }
              }
            },
            "description": "The accrual would move at least one balance outside the stored range \u00b11000000000000. The transaction rolls back, so no deposit changes."
          }
        },
        "summary": "Apply one monthly interest accrual to every deposit"
      }
    }
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ]
}
