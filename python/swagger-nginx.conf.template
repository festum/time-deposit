server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    location = /time-deposits {
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
    }

    location = /time-deposits/update-balances {
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
    }
}
